# IMPORTANT - KEEP TRACKED
# ============================================================
#
# gradle.properties
# .github/workflows/*.yml
# gradlew
# gradlew.bat
# gradle/wrapper/*
# app/src/*
# app/build.gradle.kts
# build.gradle.kts
# settings.gradle.kts
