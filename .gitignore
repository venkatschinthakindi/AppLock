# ============================================================
# QR Barcode Studio - Android / Gradle
# ============================================================

# -------------------------
# Gradle
# -------------------------
app\build\**
.gradle/
**/.gradle/
app\build/
build/
**/build/

# IMPORTANT:
# Do NOT ignore gradle.properties.
# It contains required project configuration such as
# android.useAndroidX=true.

# Keep Gradle wrapper JAR/scripts
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties
!gradlew
!gradlew.bat


# -------------------------
# Android Studio / IntelliJ
# -------------------------
.idea/
*.iml
*.ipr
*.iws

# Android Studio user-specific files
.idea/**/workspace.xml
.idea/**/tasks.xml
.idea/**/usage.statistics.xml
.idea/**/dictionaries/
.idea/**/shelf/

# Local Android Studio settings
/local.properties


