<?xml version="1.0" encoding="utf-8"?>

<!--
    AppLock uses AccessibilityService only for foreground/window detection
    and management-surface detection (Settings, package installer,
    permission controller, OEM security-center apps, and similar).

    The service reads only the package/class/window information necessary for
    foreground enforcement. It does not read, store, or transmit application
    screen content.
-->

<accessibility-service
    xmlns:android="http://schemas.android.com/apk/res/android"

    android:accessibilityEventTypes="
        typeWindowStateChanged|
        typeWindowsChanged"

    android:accessibilityFeedbackType="feedbackGeneric"

    android:accessibilityFlags="
        flagRetrieveInteractiveWindows|
        flagIncludeNotImportantViews"

    android:notificationTimeout="0"

    android:canRetrieveWindowContent="true"

    android:description="@string/accessibility_service_description" />